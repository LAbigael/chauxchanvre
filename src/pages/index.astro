---
import Layout from '../layouts/Layout.astro';
import Nav from '../layouts/Nav.astro';
import Card from '../components/Card.astro';
import ImageGallery from '../components/ImageGallery.astro';

const photosets = await fetch('https://www.flickr.com/services/rest/?method=flickr.photosets.getList&user_id=200885194%40N02&api_key='+import.meta.env.FLICKR_API_KEY+ '&format=json&nojsoncallback=1');
const sets = await photosets.json();

const photoset = sets.photosets.photoset[0];
const photosetId = photoset.id;

const photosFromSet = await fetch('https://www.flickr.com/services/rest/?method=flickr.photosets.getPhotos&user_id=200885194%40N02&photoset_id='+photosetId+'&api_key='+import.meta.env.FLICKR_API_KEY+ '&format=json&nojsoncallback=1&extras=description');

const photos = await photosFromSet.json();

console.log(photos);
//sort by title (1,2,4)

const images =  photos.photoset.photo.
map(photo => {

return({
  src: `https://live.staticflickr.com/${photo.server}/${photo.id}_${photo.secret}_b.jpg`,
  alt: photo.description._content,
  pos: photo.title
  })});

---

<Layout title="Chaux-Chanvre">
<main>
  <Nav/>
  <div class="flex flex-col items-center my-10">
  <p>+33 6 99 02 67 02</p>
  <a href="mailto:contact@chauxchaux.fr" target="_blank">contact@chauxchaux.fr</a>
  </div>
  <ImageGallery images={images} />
<footer class="flex flex-col items-center my-10">
  <p>+33 6 99 02 67 02</p>
  <a href="mailto:contact@chauxchaux.fr" target="_blank">contact@chauxchaux.fr</a>
</footer>
  <p class="text-xs opacity-70 text-center">© 2024 Chaux Chanvre</p>
</main>
</Layout>

<style is:global>

  html {
    background-color: #EEEEEE;
    margin: 0px;

  }
  footer {
    font-family: 'Chaux Chanvre';
    color: #222831;
  }
</style>
